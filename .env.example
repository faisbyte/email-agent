# ─────────────────────────────────────────────────────────────────────────────
# Outreach Agent configuration
#
# Copy this file to .env and fill in the three secrets at the top. Everything
# below them has a working default.
#
#     cp .env.example .env
#
# .env is gitignored. Never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── The three keys you must provide ──────────────────────────────────────────

# Anthropic API key. Used to compose email bodies and classify replies.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Apollo.io API key. Used to search for people and to enrich (reveal) emails.
# Settings → Integrations → API in your Apollo account.
APOLLO_API_KEY=

# Gmail app password — 16 characters, NOT your Google account password.
# Requires 2-Step Verification, then: https://myaccount.google.com/apppasswords
# Only required when you actually send (`outreach run --live`).
GMAIL_APP_PASSWORD=

# ── Who the mail comes from ──────────────────────────────────────────────────

# Signs every email. Required always — Python writes the sign-off, so there is
# no mode, dry run included, in which this is optional.
SENDER_NAME=Your Name

# Required when sending live.
GMAIL_ADDRESS=you@gmail.com

# Optional. Rendered on its own line under your name, above the removal line.
# Must include the scheme. Left unset, the line disappears cleanly.
# It sits outside the five-sentence body on purpose: spending one of five
# sentences on "you can see my work at..." is a bad trade, and a bare URL under
# the sign-off gets clicked just as often.
PERSONAL_WEBSITE=

# ── Database ─────────────────────────────────────────────────────────────────
# SQLAlchemy URL. SQLite by default, no setup required.
# Postgres/Supabase later needs no code change, only a different URL, e.g.
#   postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///outreach.db

# ── Model ────────────────────────────────────────────────────────────────────
# Must be a model that supports structured outputs; the app refuses to start
# otherwise. See STRUCTURED_OUTPUT_MODELS in src/outreach_agent/config.py.
ANTHROPIC_MODEL=claude-sonnet-5

# ── Sending limits ───────────────────────────────────────────────────────────

# Emails per calendar day (UTC). Counted from the database, so it survives
# restarts. Capped by HARD_DAILY_CAP in runner.py, which config cannot raise.
DAILY_CAP=25

# Random pause between sends, in seconds. A real person does not send on a
# metronome.
MIN_DELAY_SECONDS=30
MAX_DELAY_SECONDS=180

# ── Apollo spend control ─────────────────────────────────────────────────────
# Maximum email enrichments per run. Enrichment is the call that costs credits;
# search does not. The client refuses to exceed this.
APOLLO_ENRICHMENT_BUDGET=50

# ── Campaign and CV ──────────────────────────────────────────────────────────

# Campaign template driving tone, goal, Apollo filters and follow-up policy.
CAMPAIGN=campaigns/job_search.toml

# Plain-text CV/background. Every factual claim Claude makes about you must be
# traceable to this file, so keep it factual and current. Export your CV to
# plain text — no PDF, no DOCX. Capped at 20,000 characters, because the whole
# file is sent with every composition.
# This path is gitignored; data/cv.example.txt is the stub to copy.
CV_PATH=data/cv.txt

# ── Mail servers ─────────────────────────────────────────────────────────────
# Gmail defaults. Change only for a different provider.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX

# Delivery backend: "smtp" (Gmail app password) or "gmail_api".
# gmail_api is a stub today and raises NotImplementedError.
SENDER_BACKEND=smtp

# ── Logging ──────────────────────────────────────────────────────────────────
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
